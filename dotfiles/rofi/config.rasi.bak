configuration {
    modi: "drun,run";
    show-icons: true;
    display-drun: "󰣇 ";
    drun-display-format: "{name}";
    font: "Iosevka Nerd Font 11";
}

* {
    bg: #282828;
    bg-alt: #3c3836;
    fg: #ebdbb2;
    fg-dim: #a89984;
    accent: #fabd2f;
    border-col: #504945;

    background-color: transparent;
    text-color: @fg;
}

window {
    transparency: "real";
    background-color: @bg;
    border: 2px;
    border-color: @accent;
    border-radius: 12px;
    width: 550px;
    padding: 20px;
}

mainbox {
    spacing: 15px;
    children: [ "inputbar", "listview" ];
}

inputbar {
    background-color: @bg-alt;
    border-radius: 8px;
    padding: 12px 16px;
    children: [ "prompt", "entry" ];
    spacing: 12px;
}

prompt {
    text-color: @accent;
    font: "Iosevka Nerd Font Bold 13";
}

entry {
    placeholder: "Search applications...";
    placeholder-color: @fg-dim;
    text-color: @fg;
}

listview {
    lines: 7;
    columns: 1;
    spacing: 6px;
    fixed-height: false;
    scrollbar: false;
}

element {
    padding: 10px 14px;
    border-radius: 8px;
    spacing: 12px;
}

element selected {
    background-color: @bg-alt;
    text-color: @accent;
    border: 1px;
    border-color: @border-col;
}

element-icon {
    size: 22px;
    vertical-align: 0.5;
}

element-text {
    vertical-align: 0.5;
}
