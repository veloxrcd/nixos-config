configuration {
    font: "Iosevka Nerd Font 12";
}

* {
    bg: #282828;
    bg-alt: #3c3836;
    fg: #ebdbb2;
    red: #fb4934;
    yellow: #fabd2f;
    blue: #83a598;
    aqua: #8ec07c;

    background-color: transparent;
    text-color: @fg;
}

window {
    background-color: @bg;
    border: 2px;
    border-color: @yellow;
    border-radius: 14px;
    width: 320px;
    location: center;
    padding: 20px;
}

mainbox {
    spacing: 15px;
    children: [ "message", "listview" ];
}

message {
    background-color: @bg-alt;
    border-radius: 8px;
    padding: 10px;
    text-color: @yellow;
}

textbox {
    text-color: @yellow;
    font: "Iosevka Nerd Font Bold 13";
    horizontal-align: 0.5;
}

listview {
    lines: 4;
    columns: 1;
    spacing: 8px;
    fixed-height: true;
    fixed-columns: true;
}

element {
    padding: 12px 16px;
    border-radius: 8px;
    background-color: @bg-alt;
}

element selected {
    background-color: @yellow;
    text-color: @bg;
}

element-text {
    vertical-align: 0.5;
    horizontal-align: 0.0;
    font: "Iosevka Nerd Font Bold 12";
}
