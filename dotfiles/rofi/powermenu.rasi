configuration {
    font: "Iosevka Nerd Font 12";
}

* {
    bg0: #282828;
    bg1: #3c3836;
    fg:  #ebdbb2;
    red: #fb4934;
    yellow: #fabd2f;

    background-color: transparent;
    text-color: @fg;
}

window {
    background-color: @bg0;
    border: 2px;
    border-color: @red;
    border-radius: 12px;
    width: 320px;
    location: center;
    padding: 18px;
}

mainbox {
    spacing: 12px;
    children: [ "inputbar", "listview" ];
}

inputbar {
    children: [ "prompt" ];
    margin: 0px 0px 4px 0px;
}

prompt {
    text-color: @red;
    font: "Iosevka Nerd Font Bold 14";
}

listview {
    lines: 4;
    columns: 1;
    spacing: 8px;
    fixed-height: true;
}

element {
    padding: 10px 14px;
    border-radius: 8px;
    background-color: @bg1;
}

element selected {
    background-color: @red;
    text-color: @bg0;
}

element-text {
    vertical-align: 0.5;
    font: "Iosevka Nerd Font Bold 12";
}
