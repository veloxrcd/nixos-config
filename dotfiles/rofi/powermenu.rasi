configuration {
    font: "Iosevka Nerd Font 18";
}

* {
    bg0:     #282828;
    bg1:     #3c3836;
    fg0:     #ebdbb2;
    red:     #fb4934;
    yellow:  #fabd2f;

    background-color: transparent;
    text-color:       @fg0;
}

window {
    background-color: @bg0;
    border:           1px;
    border-color:     #504945;
    border-radius:    12px;
    width:            360px;
    location:         center;
    padding:          16px;
}

mainbox {
    children: [ "listview" ];
}

listview {
    layout:        horizontal;
    lines:         4;
    columns:       1;
    spacing:       10px;
    fixed-height:  true;
    fixed-columns: true;
}

element {
    padding:          12px 18px;
    border-radius:    8px;
    background-color: @bg1;
}

element selected {
    background-color: @fabd2f;
    text-color:       @bg0;
}

element-text {
    horizontal-align: 0.5;
    vertical-align:   0.5;
}
