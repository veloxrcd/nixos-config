configuration {
    modi: "drun,run";
    show-icons: true;
    display-drun: "󰣇";
    drun-display-format: "{name}";
    font: "Iosevka Nerd Font 10.5";
}

* {
    bg0:     #282828;
    bg1:     #3c3836;
    fg0:     #fbf1c7;
    fg1:     #ebdbb2;
    gray:    #928374;
    yellow:  #fabd2f;
    border:  #504945;

    background-color: transparent;
    text-color:       @fg1;
}

window {
    background-color: @bg0;
    border:           1px;
    border-color:     @border;
    border-radius:    10px;
    width:            480px;
    padding:          14px;
}

mainbox {
    spacing:  10px;
    children: [ "inputbar", "listview" ];
}

inputbar {
    background-color: @bg1;
    border-radius:    6px;
    padding:          8px 12px;
    children:         [ "prompt", "entry" ];
    spacing:          10px;
}

prompt {
    text-color: @yellow;
    font:       "Iosevka Nerd Font Bold 12";
}

entry {
    placeholder:       "Search...";
    placeholder-color: @gray;
    text-color:        @fg0;
}

listview {
    lines:        6;
    columns:      1;
    spacing:      4px;
    fixed-height: false;
    scrollbar:    false;
}

element {
    padding:       8px 10px;
    border-radius: 6px;
    spacing:       10px;
}

element selected {
    background-color: @bg1;
    text-color:       @yellow;
}

element-icon {
    size:           18px;
    vertical-align: 0.5;
}

element-text {
    vertical-align: 0.5;
}
