configuration {
    modi: "drun,run,filebrowser";
    show-icons: true;
    icon-theme: "Papirus";
    font: "Iosevka Nerd Font 11";
    drun-display-format: "{icon} {name}";
    display-drun: " Search";
    display-run: " Run";
    display-filebrowser: " Files";
}

* {
    bg-dim:      #1d2021;
    bg0:         #282828;
    bg1:         #3c3836;
    fg0:         #fbf1c7;
    fg1:         #ebdbb2;
    yellow:      #fabd2f;
    blue:        #83a598;
    red:         #fb4934;
    green:       #b8bb26;

    background-color: transparent;
    text-color: @fg1;
}

window {
    background-color: @bg0;
    border: 2px;
    border-color: @yellow;
    border-radius: 12px;
    width: 600px;
    padding: 20px;
}

mainbox {
    spacing: 15px;
    children: [ "inputbar", "listview" ];
}

inputbar {
    background-color: @bg1;
    border-radius: 8px;
    padding: 10px 14px;
    children: [ "prompt", "entry" ];
    spacing: 10px;
}

prompt {
    text-color: @yellow;
    font: "Iosevka Nerd Font Bold 12";
}

entry {
    placeholder: "Type to search...";
    placeholder-color: #928374;
    text-color: @fg0;
}

listview {
    lines: 8;
    columns: 1;
    spacing: 6px;
    fixed-height: false;
}

element {
    padding: 8px 12px;
    border-radius: 6px;
}

element selected {
    background-color: @bg1;
    border: 1px;
    border-color: @yellow;
    text-color: @yellow;
}

element-icon {
    size: 24px;
    margin: 0 10px 0 0;
}

element-text {
    vertical-align: 0.5;
}
