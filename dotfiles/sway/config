# ==============================================================================
# SWAY CONFIGURATION - CATPPUCCIN MOCHA SETUP
# ==============================================================================

# --- VARIABLES ---
set $mod Mod4
set $term kitty
set $browser flatpak run app.zen_browser.zen
set $wallpaper /home/mo/Downloads/storm.jpg

# --- FONT ---
font pango:Iosevka Nerd Font 10

# --- AUTOSTART SERVICES ---
exec_always pkill swaybg; swaybg -i $wallpaper -m fill
exec_always pkill waybar; waybar
exec_always pkill autotiling; autotiling

# Clipboard Daemon (Text & Images)
exec wl-paste --type text --watch cliphist store
exec wl-paste --type image --watch cliphist store

# --- GAPS & BORDERS (HYPRLAND-STYLE) ---
gaps inner 8
gaps outer 6
default_border pixel 2
smart_borders off
smart_gaps off



# --- KEYBINDINGS ---
# Core Operations
bindsym $mod+Return exec $term
bindsym $mod+w exec $browser
bindsym $mod+q kill

# Rofi Launchers & Utilities
bindsym $mod+d exec rofi -show drun
bindsym $mod+c exec cliphist list | rofi -dmenu -p "Clipboard" | cliphist decode | wl-copy
bindsym $mod+period exec rofimoji --selector-args="-theme ~/.config/rofi/config.rasi"

# Power Menu & Blurred Lock Screen (Swaylock-Effects)
bindsym $mod+Escape exec --no-startup-id echo -e "󰌾 Lock\n󰍃 Exit\n󰜉 Reboot\n󰐥 Poweroff" | rofi -dmenu -p "Power" | xargs -I {} sh -c 'case "{}" in "󰌾 Lock") swaylock -F --screenshots --clock --indicator --indicator-radius 100 --indicator-thickness 7 --effect-blur 7x5 --effect-vignette 0.5:0.5 --ring-color cba6f7 --key-hl-color 89b4fa --line-color 00000000 --inside-color 1e1e2e88 --separator-color 00000000 --grace 2 --fade-in 0.2;; "󰍃 Exit") swaymsg exit;; "󰜉 Reboot") doas reboot;; "󰐥 Poweroff") doas poweroff;; esac'

# Navigation (Vim Keys)
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

# Move Focused Window
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

# Workspaces
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4

bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4

# Layout Controls & Toggles
bindsym $mod+v floating toggle
bindsym $mod+f fullscreen toggle
bindsym $mod+Shift+c reload
bindsym $mod+Shift+e exec swaynag -t warning -m 'Exit Sway?' -B 'Yes' 'swaymsg exit'

# Mouse Controls
floating_modifier $mod normal

# --- WINDOW RULES ---
for_window [window_role="pop-up"] floating enable
for_window [window_role="bubble"] floating enable
for_window [window_role="task_dialog"] floating enable
for_window [app_id="pavucontrol"] floating enable, resize set 700 500, move position center
