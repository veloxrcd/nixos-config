# ==============================================================================
# SWAY / SWAYFX MONOCHROME CONFIG
# Location: ~/nixos-config/dotfiles/sway/config
# ==============================================================================

# ==========================================
# 1. CONSTANTS & VARS
# ==========================================
set $mod Mod4
set $term kitty
set $filemanager kitty -e yazi
set $browser zen
set $menu rofi -show drun
set $emoji rofimoji
set $power_menu ~/nixos-config/dotfiles/rofi/powermenu.sh

# Output configuration
output * bg ~/Downloads/rm-rf.jpg fill

# Custom floating layout toggle script (Moves BOTH floating windows to Top-Left & Bottom-Right)
set $float_stagger bash -c ' \
  FOCUSED_ID=$(swaymsg -t get_tree | jq -r '.. | select(.focused? == true) | .id'); \
  FLOATING_IDS=$(swaymsg -t get_tree | jq -r '.. | select(.type? == "workspace" and (.focus | length > 0)) | .. | select(.floating? == "user_on" or .floating? == "auto_on") | .id' | head -n 2); \
  ID1=$(echo "$FLOATING_IDS" | head -n 1); \
  ID2=$(echo "$FLOATING_IDS" | tail -n 1); \
  if [ -z "$ID1" ]; then \
    swaymsg "floating enable, resize set width 45ppt height 45ppt, move position 5ppt 5ppt"; \
  elif [ "$ID1" = "$ID2" ] || [ -z "$ID2" ]; then \
    swaymsg "floating enable, resize set width 45ppt height 45ppt, move position 5ppt 5ppt"; \
  else \
    FOCUSED_X=$(swaymsg -t get_tree | jq -r ".. | select(.id? == $FOCUSED_ID) | .rect.x"); \
    SCREEN_MID=$(( $(swaymsg -t get_outputs | jq -r '.[] | select(.active == true) | .rect.width' | head -n1) / 2 )); \
    if [ "$FOCUSED_X" -lt "$SCREEN_MID" ]; then \
      swaymsg "[con_id=$ID1] floating enable, resize set width 45ppt height 45ppt, move position 50ppt 50ppt"; \
      swaymsg "[con_id=$ID2] floating enable, resize set width 45ppt height 45ppt, move position 5ppt 5ppt"; \
    else \
      swaymsg "[con_id=$ID1] floating enable, resize set width 45ppt height 45ppt, move position 5ppt 5ppt"; \
      swaymsg "[con_id=$ID2] floating enable, resize set width 45ppt height 45ppt, move position 50ppt 50ppt"; \
    fi; \
  fi \
'

# Floating modifier for moving and resizing windows natively
# Super + Left Click (Hold & Drag) = Move floating window
# Super + Right Click (Hold & Drag) = Resize floating window
floating_modifier $mod normal

# Force tiled windows into floating mode when clicked with Super + LMB / RMB
bindsym --whole-window $mod+button1 floating enable
bindsym --whole-window $mod+button3 floating enable

# ==========================================
# 2. SWAYFX VISUALS & MONOCHROME BORDERS
# ==========================================
# Ultra-thin 1px borders
default_border pixel 1
default_floating_border pixel 1
smart_borders on
smart_gaps on

gaps inner 8
gaps top 2
gaps bottom 2
gaps left 4
gaps right 4

corner_radius 10

shadows enable
shadow_color #000000cc

blur enable
blur_passes 2
blur_radius 3

animation_duration_ms 150

# --- MONOCHROME WINDOW COLORS (Thin White Focused Borders) ---
# Class                 Border  BG      Text    Indicator Child_Border
client.focused          #ffffff #0b0b0b #ffffff #ffffff    #ffffff
client.focused_inactive #222222 #0b0b0b #888888 #222222    #222222
client.unfocused        #111111 #0b0b0b #555555 #111111    #111111
client.urgent           #ffffff #222222 #ffffff #ffffff    #ffffff
client.placeholder      #000000 #0c0c0c #ffffff #000000    #000000

# ==========================================
# 3. KEYBINDINGS
# ==========================================
bindsym $mod+Return exec $term
bindsym $mod+e exec $filemanager
bindsym $mod+w exec $browser
bindsym $mod+d exec $menu
bindsym $mod+period exec $emoji
bindsym $mod+Escape exec $power_menu
bindsym $mod+q kill
bindsym $mod+Shift+c reload
bindsym $mod+Shift+e exec swaynag -t warning -m 'Exit Sway?' -B 'Yes' 'swaymsg exit'

# Movement (Vim keys)
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

# Layout Controls
bindsym $mod+b splith
bindsym $mod+v splitv
bindsym $mod+f fullscreen toggle
bindsym $mod+space exec $float_stagger
bindsym $mod+Shift+space floating toggle
bindsym $mod+a focus parent

# Workspaces
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5

bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5

# Audio / Volume Controls
bindsym XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym XF86AudioRaiseVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+
bindsym XF86AudioMicMute exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle

# Screen Brightness Controls
bindsym XF86MonBrightnessDown exec brightnessctl set 5%-
bindsym XF86MonBrightnessUp exec brightnessctl set 5%+

# Screenshots
bindsym Print exec grim -g "$(slurp)" - | tee ~/Pictures/Screenshot_$(date +'%Y-%m-%d_%H-%M-%S').png | wl-copy
bindsym Shift+Print exec grim - | tee ~/Pictures/Screenshot_$(date +'%Y-%m-%d_%H-%M-%S').png | wl-copy

# ==========================================
# 4. WINDOW RULES & FLOATING DIALOGS
# ==========================================
for_window [app_id=".*"] title_format "%title"
for_window [app_id="pavucontrol"] floating enable, resize set 650 400
for_window [app_id="blueman-manager"] floating enable, resize set 600 400
for_window [window_role="pop-up"] floating enable
for_window [window_role="bubble"] floating enable
for_window [window_role="dialog"] floating enable

# ==========================================
# 5. AUTOSTART DAEMONS
# ==========================================
exec_always pkill waybar; waybar
exec_always pkill autotiling; autotiling
