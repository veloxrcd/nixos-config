# ==========================================
# 1. CONSTANTS & VARS
# ==========================================
set $mod Mod4
set $term kitty
set $filemanager kitty -e yazi
set $browser zen

# Output configuration
output * bg /home/mo/Pictures/wallpapers/storm.jpg fill

# ==========================================
# 2. SWAYFX VISUALS & ANIMATIONS
# ==========================================
# Enable SwayFX Animations & Duratio
animation_duration_ms 150

# Corner Rounding
corner_radius 12

# Shadows
shadows enable
shadow_color #000000AA

# Blur
blur enable
blur_passes 3
blur_radius 5

# Gaps & Borders
gaps inner 10
gaps outer 5
default_border normal 2
default_floating_border normal 2
smart_gaps on
smart_borders on

# ==========================================
# 3. KEYBINDINGS
# ==========================================
bindsym $mod+Return exec $term
bindsym $mod+e exec $filemanager
bindsym $mod+w exec $browser
bindsym $mod+q kill
bindsym $mod+Shift+c reload
bindsym $mod+Shift+e exec swaynag -t warning -m 'Exit Sway?' -B 'Yes' 'swaymsg exit'

# Movement (Vim keys)
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

# Layout Controls
bindsym $mod+v splitv
bindsym $mod+f fullscreen toggle
bindsym $mod+space floating toggle

# Workspaces
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5

bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5

# ==========================================
# 4. SCREENSHOT BINDINGS (GRIM + SLURP)
# ==========================================
bindsym Print exec grim -g "$(slurp)" - | tee ~/Pictures/Screenshot_$(date +'%Y-%m-%d_%H-%M-%S').png | wl-copy
bindsym Shift+Print exec grim - | tee ~/Pictures/Screenshot_$(date +'%Y-%m-%d_%H-%M-%S').png | wl-copy

# ==========================================
# 5. AUTOSTART DAEMONS
# ==========================================
exec waybar
